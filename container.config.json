{
	// 本配置文件仅配合模板部署使用，为模板部署的服务生成「服务设置」的初始值。
	// 模板部署结束后，后续服务发布与本配置文件完全无关，修改「服务设置」请到控制台操作。
	// 复制模板代码自行开发请忽略本配置文件。
	
	"containerPort": 80,                           
	"minNum": 0,                                  
	"maxNum": 5,                                  
	"cpu": 1,                                    
	"mem": 2,                                    
	"policyType": "cpu",                           
	"policyThreshold": 60,
	"policyDetails": [
		{
			"PolicyType": "cpu",
			"PolicyThreshold": 60
		},
		{
			"PolicyType": "mem",
			"PolicyThreshold": 60
		}
	],
	"envParams": {},                               
	"customLogs": "stdout",                         
	"initialDelaySeconds": 2,                       
	"dataBaseName":"django_demo",
	"executeSQLs":[
		"CREATE DATABASE IF NOT EXISTS django_demo;",
		"USE django_demo;",
		"CREATE TABLE IF NOT EXISTS `Counters` (`id` int(11) NOT NULL AUTO_INCREMENT, `count` int(11) NOT NULL DEFAULT 1, `createdAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, `updatedAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`)) ENGINE = InnoDB DEFAULT CHARSET = utf8;",
		"CREATE TABLE IF NOT EXISTS `room_records` (`id` bigint NOT NULL AUTO_INCREMENT, `room_id` varchar(128) NOT NULL, `payload` longtext NOT NULL, `owner_user_id` varchar(128) NOT NULL DEFAULT '', `created_at` datetime(6) NOT NULL, `updated_at` datetime(6) NOT NULL, PRIMARY KEY (`id`), UNIQUE KEY `room_records_room_id_uniq` (`room_id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
		"CREATE TABLE IF NOT EXISTS `user_profiles` (`id` bigint NOT NULL AUTO_INCREMENT, `actor_key` varchar(128) NOT NULL, `nick_name` varchar(128) NULL, `payload` longtext NOT NULL, `created_at` datetime(6) NOT NULL, `updated_at` datetime(6) NOT NULL, PRIMARY KEY (`id`), UNIQUE KEY `user_profiles_actor_key_uniq` (`actor_key`), UNIQUE KEY `user_profiles_nick_name_uniq` (`nick_name`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
		"CREATE TABLE IF NOT EXISTS `cancellation_notices` (`id` bigint NOT NULL AUTO_INCREMENT, `notice_id` varchar(128) NOT NULL, `recipient_user_id` varchar(128) NOT NULL, `room_id` varchar(128) NOT NULL, `payload` longtext NOT NULL, `created_at` datetime(6) NOT NULL, PRIMARY KEY (`id`), UNIQUE KEY `cancellation_notices_notice_id_uniq` (`notice_id`), KEY `cancellation_notices_recipient_idx` (`recipient_user_id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;"
	]    
}
